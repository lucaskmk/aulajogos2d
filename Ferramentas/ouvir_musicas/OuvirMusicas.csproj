<Project Sdk="Microsoft.NET.Sdk">
  <!-- Gera as músicas do jogo em WAV, fora da Unity (veja Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);TESTE_MUSICA</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\Assets\Scripts\Nucleo\Musicas.cs" Link="Musicas.cs" />
    <Compile Include="..\..\Assets\Scripts\Nucleo\SomDaMare.cs" Link="SomDaMare.cs" />
  </ItemGroup>
</Project>
